# ============================================================================
# Harness (core/config.py)
# ============================================================================

# --- provider credentials (leave blank if unused) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- the domain an orchestrator serves (also the CLI default) ---
DOMAIN=sql

# --- behaviour ---
RUNS_DIR=runs

# ============================================================================
# Domain: sql (domains/sql/config.py) -- every variable prefixed SQL_
# ============================================================================

# --- model per role, as provider:model ---
SQL_SCHEMA_MODEL=anthropic:claude-opus-5
SQL_QUERY_MODEL=anthropic:claude-opus-5
SQL_ANSWER_MODEL=anthropic:claude-opus-5

# --- service addresses ---
SQL_EXECUTOR_URL=http://localhost:8000
SQL_SCHEMA_AGENT_URL=http://localhost:8010
SQL_QUERY_AGENT_URL=http://localhost:8020
SQL_SCRATCH_URL=http://localhost:8100
SQL_LG_URL=http://localhost:8200
